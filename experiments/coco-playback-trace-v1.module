#!name=Coco 只读播放入口诊断 v1
#!desc=先关闭旧桥接及只读诊断，保留稳定字幕；不改写播放URL。
[Script]
Coco.Trace.UTS = type=http-response,engine=webview,pattern=^https:\/\/uts-api\.itunes\.apple\.com\/uts\/v[123]\/,requires-body=1,max-size=4194304,timeout=20,script-path=https://raw.githubusercontent.com/joyharry-cmd/subtitles/bed1ed7a83dd5e86e5a52586f30717856b9d6fb5/experiments/coco-playback-trace-v1-fixed.js
Coco.Trace.Health = type=http-request,engine=webview,pattern=^https:\/\/hls-amt\.itunes\.apple\.com\/__coco_trace_v1\/health$,requires-body=0,timeout=10,script-path=https://raw.githubusercontent.com/joyharry-cmd/subtitles/bed1ed7a83dd5e86e5a52586f30717856b9d6fb5/experiments/coco-playback-trace-v1-fixed.js
[MITM]
hostname = %APPEND% uts-api.itunes.apple.com, hls-amt.itunes.apple.com
