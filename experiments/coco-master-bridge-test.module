#!name=Coco 原样主清单桥接实验 v1
#!desc=仅限购买版Coco；失败时关闭本模块并重启Apple TV。无中文轨道注入。
[Script]
Coco.Bridge.UTS = type=http-response,engine=webview,pattern=^https:\/\/uts-api\.itunes\.apple\.com\/uts\/v3\/movies\/umc\.cmc\.5y1554je00oslx5xtkxv9uk7s(?:\?[^#]*)?$,requires-body=1,max-size=4194304,timeout=20,script-path=https://raw.githubusercontent.com/joyharry-cmd/subtitles/8e3c521a30cd1f508d0c9480d0f6af2c457a13f5/experiments/coco-master-bridge.js
Coco.Bridge.Master = type=http-request,engine=webview,pattern=^https:\/\/hls-amt\.itunes\.apple\.com\/__coco_master_v1\/[a-z0-9-]+\.m3u8$,requires-body=0,timeout=20,script-path=https://raw.githubusercontent.com/joyharry-cmd/subtitles/8e3c521a30cd1f508d0c9480d0f6af2c457a13f5/experiments/coco-master-bridge.js
[MITM]
hostname = %APPEND% uts-api.itunes.apple.com, hls-amt.itunes.apple.com
