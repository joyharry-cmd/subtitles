ET.iTunes.ZH = type=http-response,engine=webview,pattern=^https:\/\/vod-(?:ap|fa|ak)-amt\.tv\.apple\.com\/itunes-assets\/HLSVideo221\/v4\/55\/41\/9e\/55419e70-b301-7666-bdce-f92a910b3ede\/P1202756692_A544128124_fr-FR_subtitles_V2-(0|[1-9]|[1-8][0-9]|9[0-5])\.webvtt(?:\?[^#]*)?$,requires-body=1,max-size=2097152,timeout=30,script-path=https://raw.githubusercontent.com/joyharry-cmd/subtitles/df4cbb04a174629a035471511dca0dc18ceeea1d/et_itunes_zh.js
AppleTV.Movie.Interstellar.zh-Hans.French.response = type=http-response,engine=webview,pattern=^https:\/\/vod-(?:ap|fa|ak)-amt\.tv\.apple\.com\/itunes-assets\/(?:[^\/]+\/)+P1220541004_A960891136_fr-FR_subtitles_V2-\d+\.webvtt(?:\?.*)?$,requires-body=1,max-size=2097152,timeout=30,script-path=https://raw.githubusercontent.com/rexchen1803/apple-video-subtitles/9e7aa43bd9e1a4032d4bc780c353f8f4a6ef31bb/payloads/shadowrocket/movies/2014-interstellar/serve_interstellar_fr_as_zh_hans.js

